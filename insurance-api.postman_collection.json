              "raw": "{\n  \"patientId\": \"664f0a1b2c3d4e5f67890001\",\n  \"insuranceType\": \"Private\",\n  \"providerName\": \"Star Health\",\n  \"policyNumber\": \"SH-2026-78901\",\n  \"sumInsured\": 500000,\n  \"policyStartDate\": \"2026-01-01\",\n  \"policyEndDate\": \"2026-12-31\"\n}"
            },
            "url": {
